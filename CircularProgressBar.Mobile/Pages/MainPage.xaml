<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:cpb="clr-namespace:CircularProgressBar.Maui;assembly=CircularProgressBar.Maui"
  xmlns:shiny="http://shiny.net/maui/controls"
  xmlns:vm="clr-namespace:CircularProgressBar.Mobile.ViewModels"
  x:Class="CircularProgressBar.Mobile.MainPage"
  x:DataType="vm:MainViewModel"
  Title="Circular Progress Bar"
>
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="12">
      <cpb:CircularProgressBar
        RingThickness="{Binding RingThickness}"
        RingSpacing="{Binding RingSpacing}"
        StartAngle="{Binding StartAngle}"
        DisabledOpacity="{Binding DisabledOpacity}"
        TrackColor="{Binding TrackColor}"
        ProgressColor="{Binding ProgressColor}"
        InnerProgress="{Binding InnerProgress}"
        OuterProgress="{Binding OuterProgress}"
        IsEnabled="{Binding IsProgressEnabled}"
        ContentDiameter="{Binding ContentDiameter, Mode=OneWayToSource}"
        HorizontalOptions="Center"
      >
        <Border Stroke="Gray" StrokeThickness="1">
          <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="{Binding CenterText}" FontSize="20" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CenterText}" FontSize="20" HorizontalTextAlignment="Center" />
            <Label Text="{Binding CenterText}" FontSize="20" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Border>
      </cpb:CircularProgressBar>

      <Label
        Text="{Binding ContentDiameter, StringFormat='Content diameter: {0:F1}'}"
        HorizontalTextAlignment="Center"
      />

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding RingThickness, StringFormat='Ring thickness: {0:F1}'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="0"
          Maximum="50"
          Value="{Binding RingThickness}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding RingSpacing, StringFormat='Ring spacing: {0:F1}'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="0"
          Maximum="50"
          Value="{Binding RingSpacing}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding StartAngle, StringFormat='Start angle: {0:F0}°'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="-360"
          Maximum="360"
          Value="{Binding StartAngle}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding DisabledOpacity, StringFormat='Disabled opacity: {0:F2}'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="0"
          Maximum="1"
          Value="{Binding DisabledOpacity}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding InnerProgress, StringFormat='Inner progress: {0:P0}'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="0"
          Maximum="1"
          Value="{Binding InnerProgress}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label
          Text="{Binding OuterProgress, StringFormat='Outer progress: {0:P0}'}"
          VerticalOptions="Center"
        />
        <Slider
          Grid.Column="1"
          Minimum="0"
          Maximum="1"
          Value="{Binding OuterProgress}"
          VerticalOptions="Center"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label Text="Progress enabled" VerticalOptions="Center" />
        <Switch Grid.Column="1" IsToggled="{Binding IsProgressEnabled}" HorizontalOptions="Start" />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label Text="Track color" VerticalOptions="Center" />
        <shiny:ColorPickerButton
          Grid.Column="1"
          SelectedColor="{Binding TrackColor, Mode=TwoWay}"
          ShowOpacity="True"
          Text="Pick track color"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label Text="Progress color" VerticalOptions="Center" />
        <shiny:ColorPickerButton
          Grid.Column="1"
          SelectedColor="{Binding ProgressColor, Mode=TwoWay}"
          ShowOpacity="True"
          Text="Pick progress color"
        />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="15">
        <Label Text="Center content" VerticalOptions="Center" />
        <Entry Grid.Column="1" Text="{Binding CenterText}" Placeholder="Enter center text" />
      </Grid>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
