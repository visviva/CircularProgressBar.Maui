<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="CircularProgressBar.Mobile.Controls.SampleTemplateControl"
>
  <ContentView.Resources>
    <ControlTemplate x:Key="CardTemplate">
      <Border Stroke="Gray" StrokeThickness="1" Padding="20" Margin="30">
        <VerticalStackLayout Spacing="20">
          <Label Text="{TemplateBinding Title}" HorizontalTextAlignment="Center" />
          <ContentPresenter />
        </VerticalStackLayout>
      </Border>
    </ControlTemplate>
  </ContentView.Resources>
</ContentView>
