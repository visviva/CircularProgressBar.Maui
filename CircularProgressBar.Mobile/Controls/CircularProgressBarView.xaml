<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Name="this"
  x:Class="CircularProgressBar.Mobile.Controls.CircularProgressBarView"
  xmlns:control="clr-namespace:CircularProgressBar.Mobile.Controls"
  x:DataType="control:CircularProgressBarView"
>
  <Grid>
    <GraphicsView
      x:Name="GraphicsView"
      HeightRequest="400"
      WidthRequest="400"
      HorizontalOptions="Center"
      VerticalOptions="Center"
      ZIndex="0"
    />
    <Label
      x:Name="CenterLabel"
      Text="{Binding CenterText, Source={x:Reference this}}"
      HorizontalOptions="Center"
      VerticalOptions="Center"
      FontSize="40"
      TextColor="Pink"
      HeightRequest="250"
      WidthRequest="250"
      ZIndex="1"
    />
  </Grid>
</ContentView>
