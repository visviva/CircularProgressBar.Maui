<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="CircularProgressBar.Mobile.Controls.CircularProgressBarView"
>
  <ContentView.Resources>
    <ControlTemplate x:Key="CircularProgressBarTemplate">
      <Grid>
        <GraphicsView
          x:Name="GraphicsView"
          HeightRequest="400"
          WidthRequest="400"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          ZIndex="0"
        />

        <Grid
          HeightRequest="{TemplateBinding CenterContentMaxHeight}"
          WidthRequest="{TemplateBinding CenterContentMaxWidth}"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          IsClippedToBounds="True"
          ZIndex="1"
        >
          <ContentPresenter />
        </Grid>
      </Grid>
    </ControlTemplate>
  </ContentView.Resources>
</ContentView>
